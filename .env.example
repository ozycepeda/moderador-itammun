# Sólo se usa para cargar/probar el catálogo; el estado del debate es local.
ITAMMUN_API_BASE_URL=https://itammun.itam.mx/api/public

# Acceso general. En producción configura ambos como secretos del hosting.
ACCESS_MODE=protected
ACCESS_PIN=replace-with-a-strong-shared-password
ACCESS_SESSION_SECRET=replace-with-at-least-32-random-characters
